{
  "name": "royal-rp-website",
  "version": "1.0.0",
  "description": "Royal RP - premium FiveM roleplay server website, store, player dashboard and admin panel.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "server": "node backend/server.js",
    "setup": "node tools/setup.js",
    "repair-db": "node tools/repair-mysql.js",
    "server:dev": "node --watch backend/server.js",
    "start": "npm run server",
    "db:init": "node backend/database/init.js",
    "db:seed": "node backend/database/seed.js",
    "db:reset": "node backend/database/init.js --force && node backend/database/seed.js",
    "domain": "node tools/set-domain.js",
    "reset": "node tools/reset-for-launch.js",
    "bridge:sync": "node tools/sync-bridge-token.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "multer": "^2.5.0",
    "mysql2": "^3.11.4",
    "ws": "^8.18.0",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.3.0"
  },
  "keywords": [
    "fivem",
    "gta-v",
    "roleplay",
    "esx",
    "qbcore",
    "qbox",
    "server-website",
    "game-store"
  ],
  "license": "UNLICENSED"
}
