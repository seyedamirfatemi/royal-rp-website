# =============================================================
#  ROYAL RP - backend environment
#  Copy to backend/.env and fill in. NEVER commit the real .env.
#  Nothing in this file is ever sent to the browser.
# =============================================================

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Where the front-end is served from (used for OAuth and payment redirects)
PUBLIC_URL=http://localhost:5173

# Comma-separated list of origins allowed to make credentialed requests
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Serve the front-end from this same Node process (true in production)
SERVE_STATIC=true

# Set to true when running behind nginx / Cloudflare so client IPs are correct
TRUST_PROXY=false


# ---------------- SESSIONS ----------------
# REQUIRED in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

SESSION_COOKIE=royal_sid
SESSION_TTL_HOURS=72
SESSION_REMEMBER_DAYS=30
# Must be true once you are on HTTPS
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.royalrp.example


# ---------------- WEBSITE DATABASE ----------------
# 'sqlite' needs no setup and is perfect for development.
# Switch to 'mysql' for production.
DB_DRIVER=sqlite
DB_FILE=backend/database/royalrp.sqlite

# Used when DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=royalrp
DB_PASSWORD=
DB_NAME=royalrp
DB_POOL=10


# ---------------- FIVEM SERVER ----------------
# Public address shown to players
FIVEM_PUBLIC_ADDRESS=play.royalrp.example

# host:port of the FiveM server's HTTP endpoint (serves /info.json, /players.json).
# Leave blank and the status page honestly reports "not connected".
FIVEM_HOST=

# Shared secret for the royal-web-bridge resource (see docs/FIVEM-INTEGRATION.md).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FIVEM_API_TOKEN=

# 'auto' detects ESX / QBCore / Qbox from the live database schema.
FIVEM_FRAMEWORK=auto
FIVEM_MAX_PLAYERS=256
FIVEM_TIMEOUT_MS=5000
FIVEM_CACHE_MS=10000


# ---------------- GAME DATABASE ----------------
# The SAME MySQL database the FiveM server uses through oxmysql.
# Leave disabled and the dashboard says character data is unavailable
# rather than inventing numbers.
# Use a dedicated user with SELECT on the character tables only.
GAME_DB_ENABLED=false
GAME_DB_HOST=127.0.0.1
GAME_DB_PORT=3306
GAME_DB_USER=
GAME_DB_PASSWORD=
GAME_DB_NAME=


# ---------------- DISCORD ----------------
# https://discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:4000/api/auth/discord/callback

# Bot token, for assigning VIP roles automatically
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Role IDs granted on a VIP purchase (right-click the role -> Copy ID)
DISCORD_ROLE_VIP_BRONZE=
DISCORD_ROLE_VIP_SILVER=
DISCORD_ROLE_VIP_GOLD=
DISCORD_ROLE_VIP_PLATINUM=
DISCORD_ROLE_SUPPORTER=


# ---------------- PAYMENTS ----------------
# 'zarinpal' = درگاه زرین‌پال (ریالی - تبدیل تومان به ریال خودکار است)
# 'mock'     = فقط برای تست محلی؛ مسیر پرداخت تا تحویل را واقعی شبیه‌سازی می‌کند
# 'none'     = فروشگاه پرداخت نمی‌گیرد
PAYMENT_PROVIDER=zarinpal

# --- زرین‌پال ---
# مرچنت‌کد ۳۶ کاراکتری از پنل zarinpal.com
ZARINPAL_MERCHANT_ID=
# true = درگاه تست (sandbox)، false = درگاه واقعی
ZARINPAL_SANDBOX=true

# برای درگاه‌های مبتنی بر وب‌هوک (زرین‌پال از این استفاده نمی‌کند)
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=dev_mock_key
PAYMENT_WEBHOOK_SECRET=

CURRENCY=IRT
PAYMENT_SUCCESS_URL=http://localhost:5173/pages/checkout.html?status=success
PAYMENT_CANCEL_URL=http://localhost:5173/pages/checkout.html?status=cancelled


# ---------------- UPLOADS ----------------
UPLOAD_DIR=backend/uploads
UPLOAD_MAX_MB=10
UPLOAD_MAX_FILES=5


# ---------------- RATE LIMITS ----------------
# Requests allowed per window, per IP (or per user when signed in)
RATE_GLOBAL=300
RATE_AUTH=10
RATE_ORDER=15
RATE_TICKET=10
RATE_WRITE=60


# ---------------- LOGGING ----------------
LOG_RETENTION_DAYS=90
SECURITY_LOG_RETENTION_DAYS=365
LOG_CONSOLE=true


# ---------------- BOOTSTRAP ----------------
# This address is granted Owner on registration. The very first
# account to register also becomes Owner automatically.
BOOTSTRAP_OWNER_EMAIL=
